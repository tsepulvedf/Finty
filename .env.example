# Clave criptografica de Django. Genera una propia para cada entorno:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=cambia-esta-clave-en-cada-entorno

# Modo depuracion. Siempre False en produccion.
DEBUG=True

# Hosts autorizados, separados por coma.
ALLOWED_HOSTS=localhost,127.0.0.1

# Conexion a PostgreSQL.
DB_NAME=finty
DB_USER=finty
DB_PASSWORD=cambia-esta-password
DB_HOST=localhost
DB_PORT=5432

# Proveedor de clasificacion de transacciones que resolvera la Factory (M4).
# Valores previstos: RULE | AI | MOCK
CATEGORIZER_PROVIDER=RULE
