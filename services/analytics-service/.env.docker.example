# Configuracion de analytics-service para Docker Compose. Copiala y completala:
#   cp services/analytics-service/.env.docker.example services/analytics-service/.env.docker
#
# Este archivo contiene solo la URL de la base del servicio (A-21): analytics no
# recibe las credenciales de finty_identity ni de finty_finance, y nunca consulta
# esas bases (ADR-10); se alimenta solo de eventos. La contrasena es la de
# POSTGRES_PASSWORD en .env.docker; si tiene caracteres especiales, escapalos en
# formato URL (por ejemplo, @ -> %40).
#
# REDIS_URL la fija docker-compose.yml. Los umbrales de las reglas son opcionales
# (ARCHITECTURE.md §6); sin ellos rigen los valores por defecto, por ejemplo:
#   ANALYTICS_SPIKE_MIN_AMOUNT=50000
#   ANALYTICS_PUBLIC_MIN_USERS=3

DATABASE_URL=postgresql+psycopg2://finty:cambia-esta-password@db:5432/finty_analytics

TIME_ZONE=America/Bogota
