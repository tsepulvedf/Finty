# Configuracion de recommendation-service para Docker Compose. Copiala y completala:
#   cp services/recommendation-service/.env.docker.example services/recommendation-service/.env.docker
#
# Este archivo contiene solo la URL de la base del servicio (A-21): no recibe las
# credenciales de finty_identity, finty_finance ni finty_analytics, y nunca las
# consulta (ADR-10). Lo que sabe de las finanzas del usuario lo pide a
# analytics-service por HTTP. La contrasena es la de POSTGRES_PASSWORD en
# .env.docker; si tiene caracteres especiales, escapalos en formato URL.
#
# ANALYTICS_URL, REDIS_URL y EXCHANGE_RATE_API_URL los fija docker-compose.yml.
# Opcionales (ARCHITECTURE.md §6.6), con su valor por defecto:
#   RECOMMENDATION_RATE_MODERATE=0.10

DATABASE_URL=postgresql+psycopg2://finty:cambia-esta-password@db:5432/finty_recommendation

TIME_ZONE=America/Bogota

# Tasa fija USD→COP: el ultimo recurso cuando ni la API de la TRM ni el cache de
# Redis tienen una tasa (ADR-12). Se reporta siempre como `fallback`.
# Referencia: TRM oficial del 2026-10-21 = 3163,76 COP por dolar, redondeada a 3200.
# Actualizala, con su fecha, si la TRM se aleja mucho de este valor.
EXCHANGE_RATE_FALLBACK_USD_COP=3200
