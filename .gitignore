# Entorno: cualquier variante de .env (.env.docker, .env.prod, ...) queda
# ignorada; solo se versionan las plantillas .env*.example.
.env
.env.*
!.env*.example
venv/
.venv/

# Python
__pycache__/
*.pyc

# Django
db.sqlite3
staticfiles/
# Los catalogos compilados se generan en el build de la imagen (Dockerfile):
# la unica fuente versionada son los .po.
*.mo

# Tests
.pytest_cache/
.coverage
htmlcov/

# Editores
.idea/
.vscode/
