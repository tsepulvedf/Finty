#: frontend/static/finty/js/codes.js
msgid "El correo o la contraseña no son correctos. Revísalos e inténtalo de nuevo."
msgstr "The email or password is incorrect. Check them and try again."

#: frontend/static/finty/js/codes.js
msgid "Ya existe una cuenta con ese correo. Ingresa con él o usa otro."
msgstr "An account with that email already exists. Log in with it or use another one."

#: frontend/static/finty/js/codes.js
msgid "La contraseña es muy débil: usa al menos 8 caracteres, que no sean solo números ni una contraseña común."
msgstr "The password is too weak: use at least 8 characters, not only numbers and not a common password."

#: frontend/static/finty/js/codes.js
msgid "Esta cuenta está inactiva."
msgstr "This account is inactive."

#: frontend/static/finty/js/codes.js
msgid "El monto debe ser distinto de cero."
msgstr "The amount can't be zero."

#: frontend/static/finty/js/codes.js
msgid "Escribe el monto sin signo: el tipo de movimiento ya indica si suma o resta."
msgstr "Enter the amount without a sign: the transaction type already says whether it adds or subtracts."

#: frontend/static/finty/js/codes.js
msgid "La fecha del movimiento no puede ser futura."
msgstr "The transaction date can't be in the future."

#: frontend/static/finty/js/codes.js
msgid "Esa categoría no existe."
msgstr "That category doesn't exist."

#: frontend/static/finty/js/codes.js
msgid "Esa categoría no corresponde al tipo de movimiento."
msgstr "That category doesn't match the transaction type."

#: frontend/static/finty/js/codes.js
msgid "Ya tienes una cuenta con ese nombre."
msgstr "You already have an account with that name."

#: frontend/static/finty/js/codes.js
msgid "La cuenta está archivada y no admite movimientos."
msgstr "The account is archived and doesn't accept transactions."

#: frontend/static/finty/js/codes.js
msgid "No encontramos esa cuenta."
msgstr "We couldn't find that account."

#: frontend/static/finty/js/codes.js
msgid "No encontramos ese movimiento. Puede que ya se haya eliminado."
msgstr "We couldn't find that transaction. It may have been deleted."

#: frontend/static/finty/js/codes.js
msgid "Este movimiento dejaría la cuenta en negativo, y su tipo no lo permite."
msgstr "This transaction would leave the account negative, and its type doesn't allow it."

#: frontend/static/finty/js/codes.js
msgid "La moneda no coincide con la de la cuenta."
msgstr "The currency doesn't match the account's currency."

#: frontend/static/finty/js/codes.js
msgid "La cuenta tiene movimientos: archívala en lugar de eliminarla."
msgstr "The account has transactions: archive it instead of deleting it."

#: frontend/static/finty/js/codes.js
msgid "El tipo de movimiento no es válido."
msgstr "The transaction type isn't valid."

#: frontend/static/finty/js/codes.js
msgid "El movimiento no tiene categoría."
msgstr "The transaction has no category."

#: frontend/static/finty/js/codes.js
msgid "El período no es válido."
msgstr "The period isn't valid."

#: frontend/static/finty/js/codes.js
msgid "Esta función es parte del plan Premium."
msgstr "This feature is part of the Premium plan."

#: frontend/static/finty/js/codes.js
msgid "No pudimos verificar tu plan en este momento. Intenta de nuevo en unos minutos."
msgstr "We couldn't verify your plan right now. Try again in a few minutes."

#: frontend/static/finty/js/codes.js
msgid "Solo se puede convertir entre pesos y dólares."
msgstr "Only conversions between pesos and dollars are available."

#: frontend/static/finty/js/codes.js
msgid "El plan Free no requiere pago."
msgstr "The Free plan doesn't require payment."

#: frontend/static/finty/js/codes.js
msgid "Ya tienes una suscripción vigente."
msgstr "You already have an active subscription."

#: frontend/static/finty/js/codes.js
msgid "Tienes un pago en proceso."
msgstr "You have a payment in progress."

#: frontend/static/finty/js/codes.js
msgid "No tienes una suscripción activa."
msgstr "You don't have an active subscription."

#: frontend/static/finty/js/codes.js
msgid "Todavía no has respondido el cuestionario de perfil de riesgo."
msgstr "You haven't answered the risk profile questionnaire yet."

#: frontend/static/finty/js/codes.js
msgid "Responde el cuestionario de perfil de riesgo antes de guardar un plan."
msgstr "Answer the risk profile questionnaire before saving a plan."

#: frontend/static/finty/js/codes.js
msgid "Cada respuesta del cuestionario vale 1, 2 o 3."
msgstr "Each questionnaire answer is worth 1, 2 or 3."

#: frontend/static/finty/js/codes.js
msgid "Ese instrumento no corresponde a tu perfil de riesgo."
msgstr "That instrument doesn't match your risk profile."

#: frontend/static/finty/js/codes.js
msgid "El aporte mensual debe ser mayor que cero."
msgstr "The monthly contribution must be greater than zero."

#: frontend/static/finty/js/codes.js
msgid "El horizonte del plan está fuera del rango permitido."
msgstr "The plan's horizon is outside the allowed range."

#: frontend/static/finty/js/codes.js
msgid "No encontramos ese plan de inversión."
msgstr "We couldn't find that investment plan."

#: frontend/static/finty/js/codes.js
msgid "No pudimos conectar con Finty. Revisa tu conexión e intenta de nuevo."
msgstr "We couldn't reach Finty. Check your connection and try again."

#: frontend/static/finty/js/codes.js
msgid "Tu sesión no es válida o expiró. Ingresa de nuevo."
msgstr "Your session is invalid or has expired. Log in again."

#: frontend/static/finty/js/codes.js
msgid "No tienes acceso a esta función."
msgstr "You don't have access to this feature."

#: frontend/static/finty/js/codes.js
msgid "No encontramos lo que buscabas."
msgstr "We couldn't find what you were looking for."

#: frontend/static/finty/js/codes.js
msgid "Hiciste demasiadas solicitudes seguidas. Espera un momento e intenta de nuevo."
msgstr "You made too many requests in a row. Wait a moment and try again."

#: frontend/static/finty/js/codes.js
msgid "El servicio no está disponible en este momento. Intenta de nuevo en unos minutos."
msgstr "The service isn't available right now. Try again in a few minutes."

#: frontend/static/finty/js/codes.js
msgid "Algo salió mal. Intenta de nuevo."
msgstr "Something went wrong. Try again."

