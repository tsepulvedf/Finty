# Configuracion de subscription-service para Docker Compose. Copiala y completala:
#   cp services/subscription-service/.env.docker.example services/subscription-service/.env.docker
#
# Este archivo contiene solo la URL de la base del servicio (A-21). La contrasena
# es la de POSTGRES_PASSWORD en .env.docker; si tiene caracteres especiales,
# escapalos en formato URL.
#
# PAYMENT_GATEWAY lo fija docker-compose.yml (MOCK por defecto; en E2-M6a es la
# unica pasarela). Opcional, con su valor por defecto (29 900 COP al mes):
#   SUBSCRIPTION_PREMIUM_PRICE_IN_CENTS=2990000

DATABASE_URL=postgresql+psycopg2://finty:cambia-esta-password@db:5432/finty_subscription

TIME_ZONE=America/Bogota
