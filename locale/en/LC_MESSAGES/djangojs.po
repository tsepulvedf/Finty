#: frontend/static/finty/js/pages/dashboard.js
msgid "Tu resumen de %(month)s"
msgstr "Your %(month)s summary"

#: frontend/static/finty/js/pages/dashboard.js
msgid "Conversión con la TRM oficial del %(date)s: %(rate)s por dólar · fuente: %(source)s. Los montos guardados no cambian."
msgstr "Converted with the official exchange rate (TRM) of %(date)s: %(rate)s per dollar · source: %(source)s. Stored amounts don't change."

#: frontend/static/finty/js/pages/dashboard.js
msgid "Conversión con una tasa de %(rate)s por dólar · fuente: %(source)s. Los montos guardados no cambian."
msgstr "Converted with a rate of %(rate)s per dollar · source: %(source)s. Stored amounts don't change."

#: frontend/static/finty/js/pages/dashboard.js
msgid "No pudimos obtener la tasa de cambio: los montos se muestran en su moneda original."
msgstr "We couldn't get the exchange rate: amounts are shown in their original currency."

#: frontend/static/finty/js/pages/dashboard.js
msgid "%(month)s: %(amount)s"
msgstr "%(month)s: %(amount)s"

#: frontend/static/finty/js/pages/dashboard.js
msgid "Convertido desde %(currency)s"
msgstr "Converted from %(currency)s"

#: frontend/static/finty/js/pages/dashboard.js
msgid "Ingresos"
msgstr "Income"

#: frontend/static/finty/js/pages/dashboard.js
msgid "Gastos"
msgstr "Expenses"

#: frontend/static/finty/js/pages/dashboard.js
msgid "Neto del mes"
msgstr "Net for the month"

#: frontend/static/finty/js/pages/dashboard.js
msgid "Ingresos menos gastos del período"
msgstr "Income minus expenses for the period"

#: frontend/static/finty/js/pages/dashboard.js
msgid "También tienes movimientos en %(currency)s este mes: ingresos %(income)s y gastos %(expense)s."
msgstr "You also have transactions in %(currency)s this month: income %(income)s and expenses %(expense)s."

#: frontend/static/finty/js/pages/dashboard.js
msgid "%(month)s: ingresos %(income)s, gastos %(expense)s"
msgstr "%(month)s: income %(income)s, expenses %(expense)s"

#: frontend/static/finty/js/pages/dashboard.js
msgid "Sin gastos en este período"
msgstr "No expenses in this period"

#: frontend/static/finty/js/pages/dashboard.js
msgid "Cuando registres gastos, verás aquí en qué se va tu dinero."
msgstr "When you add expenses, you'll see here where your money goes."

#: frontend/static/finty/js/pages/dashboard.js
msgid "El plan Free muestra los últimos %(months)s meses. Con Premium ves todo tu historial."
msgstr "The Free plan shows the last %(months)s months. With Premium you see your whole history."

#: frontend/static/finty/js/pages/dashboard.js
msgid "Registrar un movimiento"
msgstr "Add a transaction"

#: frontend/static/finty/js/pages/dashboard.js
msgid "Crea tu primera cuenta"
msgstr "Create your first account"

#: frontend/static/finty/js/pages/dashboard.js
msgid "No hay movimientos en %(period)s"
msgstr "No transactions in %(period)s"

#: frontend/static/finty/js/pages/dashboard.js
msgid "Los indicadores aparecen cuando registras ingresos o gastos en el período."
msgstr "Indicators appear when you add income or expenses in the period."

#: frontend/static/finty/js/pages/dashboard.js
msgid "Sin datos para la tendencia"
msgstr "No data for the trend"

#: frontend/static/finty/js/pages/dashboard.js
msgid "Registra movimientos para ver cómo cambian tus ingresos y gastos mes a mes."
msgstr "Add transactions to see how your income and expenses change month by month."

#: frontend/static/finty/js/pages/dashboard.js
msgid "Este período está fuera de los últimos %(months)s meses que incluye el plan Free."
msgstr "This period is outside the last %(months)s months included in the Free plan."

#: frontend/static/finty/js/pages/dashboard.js
msgid "Período no disponible en tu plan"
msgstr "Period not available on your plan"

#: frontend/static/finty/js/pages/dashboard.js
msgid "Vuelve a un mes reciente o pásate a Premium para ver todo tu historial."
msgstr "Go back to a recent month or upgrade to Premium to see your whole history."

#: frontend/static/finty/js/pages/dashboard.js
msgid "Registra dónde tienes tu dinero: efectivo, banco o tarjeta de crédito."
msgstr "Add where you keep your money: cash, bank or credit card."

#: frontend/static/finty/js/pages/dashboard.js
msgid "Crear cuenta"
msgstr "Create account"

#: frontend/static/finty/js/pages/dashboard.js
#: frontend/static/finty/js/pages/transactions.js
msgid "Todavía no hay movimientos"
msgstr "No transactions yet"

#: frontend/static/finty/js/pages/dashboard.js
msgid "Registra tu primer gasto o ingreso y Finty lo clasificará por ti."
msgstr "Add your first expense or income and Finty will categorize it for you."

#: frontend/static/finty/js/pages/dashboard.js
msgid "Con Premium, Finty detecta hallazgos y gastos recurrentes en tus movimientos."
msgstr "With Premium, Finty finds insights and recurring expenses in your transactions."

#: frontend/static/finty/js/pages/dashboard.js
msgid "Incluido en el plan Premium"
msgstr "Included in the Premium plan"

#: frontend/static/finty/js/pages/dashboard.js
msgid "Este mes: %(findings)s y %(recurring)s."
msgstr "This month: %(findings)s and %(recurring)s."

#: frontend/static/finty/js/pages/dashboard.js
msgid "%(count)s hallazgo"
msgid_plural "%(count)s hallazgos"
msgstr[0] "%(count)s insight"
msgstr[1] "%(count)s insights"

#: frontend/static/finty/js/pages/dashboard.js
msgid "%(count)s gasto recurrente"
msgid_plural "%(count)s gastos recurrentes"
msgstr[0] "%(count)s recurring expense"
msgstr[1] "%(count)s recurring expenses"

#: frontend/static/finty/js/pages/dashboard.js
msgid "Los verás en detalle en la sección de insights."
msgstr "You'll see them in detail in the insights section."

#: frontend/static/finty/js/pages/dashboard.js
#: frontend/static/finty/js/pages/register.js
#: frontend/static/finty/js/pages/transactions.js
msgid "Este campo es obligatorio."
msgstr "This field is required."

#: frontend/static/finty/js/pages/dashboard.js
msgid "Cuenta «%(name)s» creada."
msgstr "Account “%(name)s” created."

#: frontend/static/finty/js/pages/dashboard.js
msgid "Hola, %(name)s"
msgstr "Hi, %(name)s"

#: frontend/static/finty/js/pages/login.js
msgid "Escribe tu correo y tu contraseña."
msgstr "Enter your email and password."

#: frontend/static/finty/js/pages/transactions.js
msgid "todas las cuentas"
msgstr "all accounts"

#: frontend/static/finty/js/pages/transactions.js
msgid "%(count)s movimiento · %(scope)s"
msgid_plural "%(count)s movimientos · %(scope)s"
msgstr[0] "%(count)s transaction · %(scope)s"
msgstr[1] "%(count)s transactions · %(scope)s"

#: frontend/static/finty/js/pages/transactions.js
msgid "Ningún movimiento coincide con los filtros"
msgstr "No transactions match the filters"

#: frontend/static/finty/js/pages/transactions.js
msgid "Cambia o limpia los filtros para ver más movimientos."
msgstr "Change or clear the filters to see more transactions."

#: frontend/static/finty/js/pages/transactions.js
msgid "Registra tu primer gasto o ingreso con el formulario. Finty lo clasificará por ti."
msgstr "Add your first expense or income with the form. Finty will categorize it for you."

#: frontend/static/finty/js/pages/transactions.js
msgid "Movimientos: elige uno para ver su detalle."
msgstr "Transactions: choose one to see its details."

#: frontend/static/finty/js/pages/transactions.js
