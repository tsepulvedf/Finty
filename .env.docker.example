# Configuracion para Docker Compose. Copiala a .env.docker y completala:
#   cp .env.docker.example .env.docker
#
# Es independiente de .env, que sigue siendo la configuracion de la ejecucion
# local con PostgreSQL en el host. Compose entrega este archivo a los
# contenedores en tiempo de ejecucion; nunca entra en una imagen.

# --- Django ------------------------------------------------------------------

# Genera una propia:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Compose interpreta `$` dentro de este archivo como una variable: si la clave
# generada contiene `$`, encierrala entre comillas simples.
SECRET_KEY=cambia-esta-clave-en-cada-entorno

DEBUG=False

# Hosts con los que se llega al Gateway. En EC2 se agrega la IP elastica.
ALLOWED_HOSTS=localhost,127.0.0.1

# Base logica del monolito (ADR-10). DB_HOST es el nombre del servicio de
# Compose, no localhost.
DB_NAME=finty_identity
DB_USER=finty
DB_PASSWORD=cambia-esta-password
DB_HOST=db
DB_PORT=5432

# --- PostgreSQL (contenedor db) ----------------------------------------------

# Deben coincidir con DB_USER y DB_PASSWORD. POSTGRES_DB=postgres evita que la
# imagen cree una base extra con el nombre del usuario: las bases de Finty las
# crea deploy/postgres/init/01-create-databases.sh.
POSTGRES_USER=finty
POSTGRES_PASSWORD=cambia-esta-password
POSTGRES_DB=postgres
