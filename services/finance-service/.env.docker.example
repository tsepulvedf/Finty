# Configuracion de finance-service para Docker Compose. Copiala y completala:
#   cp services/finance-service/.env.docker.example services/finance-service/.env.docker
#
# Este archivo contiene solo la URL de la base del servicio (A-21): ni las
# credenciales de finty_identity ni la SECRET_KEY de Django llegan a este
# contenedor. La contrasena es la de POSTGRES_PASSWORD en .env.docker; si tiene
# caracteres especiales, escapalos en formato URL (por ejemplo, @ -> %40).

DATABASE_URL=postgresql+psycopg2://finty:cambia-esta-password@db:5432/finty_finance

CATEGORIZER_PROVIDER=RULE
TIME_ZONE=America/Bogota
